# ─────────────────────────────────────────────────────────────
# XYZ RAG Document Pipeline — Environment Configuration
# ─────────────────────────────────────────────────────────────
#
# SETUP INSTRUCTIONS:
#   1. Copy this file and rename it to `.env`
#      (cp .env.example .env  on Mac/Linux)
#      (copy .env.example .env  on Windows)
#   2. Replace the placeholder below with your actual Gemini API key.
#   3. Never commit your real .env file — it is excluded via .gitignore.
#
# HOW TO GET A GEMINI API KEY:
#   → Visit: https://aistudio.google.com/app/apikey
#   → Sign in with your Google account
#   → Click "Create API Key"
#
# NOTE: If you leave GEMINI_API_KEY empty, the pipeline will run in
# Offline / Mock Mode automatically — no API key required for a demo.
# ─────────────────────────────────────────────────────────────

GEMINI_API_KEY=your_gemini_api_key_here
